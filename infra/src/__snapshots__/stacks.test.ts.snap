    "HttpStageB46AEAD3": {
      "Properties": {
        "AccessLogSettings": {
          "DestinationArn": {
            "Fn::GetAtt": [
              "HttpAccessLogs7ADEF396",
              "Arn",
            ],
          },
          "Format": "{"requestId":"$context.requestId","ip":"$context.identity.sourceIp","requestTime":"$context.requestTime","method":"$context.httpMethod","routeKey":"$context.routeKey","status":"$context.status","latency":"$context.responseLatency","integrationError":"$context.integrationErrorMessage","authorizerError":"$context.authorizer.error"}",
        },
        "ApiId": {
          "Ref": "HttpApiF5A9A8A7",
        },
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 40,
          "ThrottlingRateLimit": 20,
        },
        "StageName": "$default",
        "Tags": {
          "project": "incident-command-agent",
        },
      },
      "Type": "AWS::ApiGatewayV2::Stage",
    },
    "MonthlyBudget": {
      "Properties": {
        "Budget": {
          "BudgetLimit": {
            "Amount": 20,
            "Unit": "USD",
          },
          "BudgetType": "COST",
          "TimeUnit": "MONTHLY",
        },
        "NotificationsWithSubscribers": [
          {
            "Notification": {
              "ComparisonOperator": "GREATER_THAN",
              "NotificationType": "ACTUAL",
              "Threshold": 80,
              "ThresholdType": "PERCENTAGE",
            },
            "Subscribers": [
              {
                "Address": "ops@example.com",
                "SubscriptionType": "EMAIL",
              },
            ],
          },
          {
            "Notification": {
              "ComparisonOperator": "GREATER_THAN",
              "NotificationType": "ACTUAL",
              "Threshold": 100,
              "ThresholdType": "PERCENTAGE",
            },
            "Subscribers": [
              {
                "Address": "ops@example.com",
                "SubscriptionType": "EMAIL",
              },
            ],
          },
        ],
      },
      "Type": "AWS::Budgets::Budget",
    },
    "RunDurationP95F84EF2A0": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "AlarmTopicD01E77F9",
          },
        ],
        "AlarmDescription": "Run Lambda p95 duration > 12 min",
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "RunFn607F19B8",
            },
          },
        ],
        "EvaluationPeriods": 1,
        "ExtendedStatistic": "p95",
        "MetricName": "Duration",
        "Namespace": "AWS/Lambda",
        "Period": 300,
        "Tags": [
          {
            "Key": "project",
            "Value": "incident-command-agent",
          },
        ],
        "Threshold": 720000,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "RunErrors442605E6": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "AlarmTopicD01E77F9",
          },
        ],
        "AlarmDescription": "Run Lambda errors",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "RunFn607F19B8",
            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "Errors",
        "Namespace": "AWS/Lambda",
        "Period": 300,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "project",
            "Value": "incident-command-agent",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "RunFn607F19B8": {
      "DependsOn": [
        "RunFnServiceRoleDefaultPolicyA7373DFC",
        "RunFnServiceRole295129E9",
      ],
      "Properties": {
        "Architectures": [
          "arm64",
        ],
        "Code": {
          "S3Bucket": {
            "Fn::Sub": "cdk-hnb659fds-assets-\${AWS::AccountId}-eu-west-2",
          },
          "S3Key": "ASSET",
        },
        "Description": "Run Lambda: world engine + agents for one scenario run",
        "Environment": {
          "Variables": {
            "FEATURE_WEB_SEARCH": "true",
            "KB_EMBEDDINGS": "cohere",
            "KB_EMBED_DIMS": "1536",
            "KB_EMBED_MODEL": "eu.cohere.embed-v4:0",
            "KB_EMBED_REGION": "eu-west-2",
            "KB_RERANK": "on",
            "KB_RERANK_MODEL": "cohere.rerank-v3-5:0",
            "KB_RERANK_REGION": "eu-central-1",
            "KB_VECTOR_BUCKET": {
              "Fn::Select": [
                1,
                {
                  "Fn::Split": [
                    "/",
                    {
                      "Fn::ImportValue": "Ica-Data:ExportsOutputFnGetAttKnowledgeVectorBucketVectorBucketArnAA4297F4",
                    },
                  ],
                },
              ],
            },
            "KB_VECTOR_INDEX": {
              "Fn::Select": [
                3,
                {
                  "Fn::Split": [
                    "/",
                    {
                      "Fn::ImportValue": "Ica-Data:ExportsOutputFnGetAttKnowledgeVectorIndexIndexArn8EEC6CFC",
                    },
                  ],
                },
              ],
            },
            "KB_VECTOR_STORE": "s3vectors",
            "KNOWLEDGE_BUCKET": {
              "Fn::ImportValue": "Ica-Data:ExportsOutputRefKnowledgeBucketD7C8B00D4F4CC779",
            },
            "LLM_MODEL": "claude-sonnet-5",
            "LLM_PROVIDER": "anthropic",
            "LLM_SECRET_ARN": {
              "Fn::ImportValue": "Ica-Data:ExportsOutputRefLlmSecret60D8EC95B4367E53",
            },
            "MAX_RUNS_PER_DAY": "20",
            "NODE_OPTIONS": "--enable-source-maps",
            "SEARCH_SECRET_ARN": {
              "Fn::ImportValue": "Ica-Data:ExportsOutputRefSearchSecret1A867649BFD9F317",
            },
            "TABLE_NAME": {
              "Fn::ImportValue": "Ica-Data:ExportsOutputRefTableCD117FA1D18A8047",
            },
            "TRACES_BUCKET": {
              "Fn::ImportValue": "Ica-Data:ExportsOutputRefTracesBucketEEE0B20C02BB6EAC",
            },
          },
