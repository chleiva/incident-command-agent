{
  "name": "@ica/web",
  "version": "0.1.0",
  "private": true,
  "description": "Incident Coordination Agent — React 18 + Vite cockpit SPA and Storybook. Owned by task 05.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "dev:aws": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "build:mock": "VITE_MOCK=1 vite build --outDir dist-mock",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "tsx scripts/fixtures/build.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "storybook:a11y": "node scripts/a11y-storybook.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "gifs": "node scripts/media.mjs --gifs",
    "readme:screenshots": "node scripts/media.mjs --pngs"
  },
  "dependencies": {
    "@ica/network": "*",
    "@ica/schema": "*",
    "@ica/ui-tokens": "*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.13",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "cmdk": "^1.1.1",
    "d3-geo": "^3.1.1",
    "framer-motion": "^13.4.4",
    "oidc-client-ts": "^3.5.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "storybook": "^10.6.0",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.6"
  }
}
