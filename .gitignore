# Dependencies and build output
node_modules/
dist/
cdk.out/
coverage/
storybook-static/
*.tsbuildinfo

# Secrets and local configuration (never commit)
.env
.env.*
!.env.example
config/brand.local.json
config/private-words.txt

# Private content and large data
scenarios/private/
data/raw/
data/index/

# Local runtime state (traces, run logs, dev spend, persisted store)
.local/

# Generated by npm run dev / dev:aws (WebRuntimeConfig for the Vite dev server)
apps/web/public/config.json

# Local eval reports (committed reports are YYYY-MM-DD-<tier>.json/.md)
evals/reports/*.local.*

# OS / editor noise
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Agent worktrees
.claude/worktrees/

# Private notes (owner only)
tech_explanation.md
ai-solution.md
