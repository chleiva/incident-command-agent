# Incident Coordination Agent — environment. Copy to .env (git-ignored) and fill in.
# Keys belong in .env locally only; in AWS they live in Secrets Manager (npm run secrets:set).

# ── LLM provider ───────────────────────────────────────────────────────────────
# anthropic | openai | bedrock | replay | scripted
LLM_PROVIDER=anthropic
# Agents default to Sonnet 5; use claude-haiku-4-5 for cheap dev runs.
LLM_MODEL=claude-sonnet-5
# Optional per-run fallback after two 5xx responses from the primary.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
# Must be <= 0.2 (NFR-03; values above are rejected).
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
# Local only. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Run limits and cost guards ─────────────────────────────────────────────────
# Optional per-run cost stop in USD. 0 = no limit (default): only the eval harness caps spend.
RUN_BUDGET_USD=0
# Sim minutes before a run ends at the horizon (evals use 60).
RUN_HORIZON_MIN=180
# Optional daily cap enforced by the API (429 when exceeded). 0 = no limit (default).
MAX_RUNS_PER_DAY=0
# Simulation safety net: an approval still pending after this much REAL time (ms) is approved automatically and
# recorded as "Auto-approved (simulation)", so unattended runs do not stall. 0 = off. Not used by evals or baselines.
SIM_AUTO_APPROVE_AFTER_MS=120000

# ── Evaluation (lifetime £10 cap, see docs/adr/0006-eval-budget-guard.md) ──────
EVAL_JUDGE_MODEL=claude-opus-5-5
# Can only LOWER the hard-coded lifetime cap of 10; higher values are ignored.
EVAL_LIFETIME_CAP_GBP=10
# Conservative (low) GBP→USD rate; defaults to config/pricing.json gbpUsdRate.
GBP_USD_RATE=1.20

# ── Knowledge base ─────────────────────────────────────────────────────────────
# kb:build embeddings: local (transformers.js MiniLM, free) | cohere (Cohere Embed v4 on Bedrock, EU profile
# eu.cohere.embed-v4:0, 1536 dims, vectors in S3 Vectors; ≈ USD 1.1 one-off) | openai | none (BM25 only).
# The deployed Lambdas query with Cohere (CDK sets KB_VECTOR_*, KB_EMBED_*, KB_RERANK_*; docs/deploy.md), so build
# with KB_EMBEDDINGS=cohere before `npm run kb:upload`. Locally, `local` and `none` need no AWS access.
KB_EMBEDDINGS=local
# ASRS precedents kept (relevance-ranked; default 15000) and minimum relevance score (default 1).
# KB_ASRS_CAP=15000
# Where the local model files are cached (default: the transformers.js cache in node_modules).
# KB_MODEL_CACHE=.cache/hf
# FSF ramp template: redistribution unconfirmed, local use only.
KB_INCLUDE_FSF=false

# ── Guardrails and features ────────────────────────────────────────────────────
# Adds a cheap LLM classifier (Haiku) to regex input screening.
SCREEN_WITH_LLM=false
# Scenario Author web search (allow-listed domains only); needs a search key.
FEATURE_WEB_SEARCH=false
TAVILY_API_KEY=
BRAVE_API_KEY=
# get_weather uses live NOAA METAR instead of the scenario snapshot.
FEATURE_LIVE_WEATHER=false

# ── Auth and AWS ───────────────────────────────────────────────────────────────
# none = local dev server only (never deployable) | cognito
AUTH_MODE=none
AWS_REGION=eu-west-2
# AWS Budgets and CloudWatch alarm notifications.
ALERT_EMAIL=
# Cognito hosted-UI domain prefix (must be globally unique in the region).
COGNITO_DOMAIN_PREFIX=

# Rerank requests per minute each Run Lambda container may spend (Cohere Rerank 3.5 on-demand quota is 3/min
# on a new account and not adjustable in Service Quotas; raise via an AWS Support case, then raise this). 0 = unlimited.
# Rerank is selective: skipped when BM25 and vectors agree on the top document, cached per query.
KB_RERANK_RPM=3
